{
  "name": "@seda-ai/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./profiles.json": "./dist/profiles.json",
    "./icons.json": "./dist/icon-catalog.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:breadcrumbs": "node scripts/verify-breadcrumbs-package.mjs",
    "verify:catalog": "node --test scripts/component-catalog.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": ">=18",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.25.5",
    "playwright": "1.64.1",
    "typescript": ">=5"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ]
}
