  "behavior": {
    "owner": "form",
    "nativeBrowserValidation": {
      "formNoValidate": true,
      "requiredAttribute": true,
      "reason": "Form renders the agreed error and owns focus recovery"
    },
    "validation": {
      "ruleId": "project-name-required",
      "rule": "trim(value).length > 0",
      "message": "Введите название проекта.",
      "triggers": [
        "blur",
        "submit"
      ],
      "revalidateOnInput": "after-an-error-has-been-shown",
      "normalizeDisplayedValue": false,
      "invalidSubmit": {
        "attemptedSubmit": true,
        "showFieldError": true,
        "startSave": false,
        "preserveValue": true,
        "focusTarget": "projectName"
      }
    },
    "submit": {
      "guard": "ignore-while-saving-for-every-submit-route",
      "capture": "submitted-value-snapshot",
      "inputDuringSaving": "editable",
      "responsePolicy": "never-overwrite-more-recent-input",
      "successPolicy": "mark-submitted-snapshot-saved-newer-input-remains-dirty"
    },
    "failure": {
      "scope": "form",
      "message": "Не удалось сохранить изменения. Попробуйте ещё раз.",
      "fieldInvalid": false,
      "retry": "validate-and-submit-current-value"
    },
    "cancellation": {
      "action": "restore-last-saved-snapshot-and-clear-local-errors",
      "duringSaving": "disabled",
      "neverAbortUnspecifiedBackendRequest": true
    },
    "help": {
      "action": "toggle-inline-help",
      "focus": "keep-on-help-button",
      "expandedAttribute": "native-aria-expanded",
      "helpText": "Название помогает отличать этот проект от других. Оно не должно быть пустым.",
      "selectedCapability": "not-used-do-not-emit-aria-pressed"
    },
    "profileUpdate": {
      "preserve": [
        "value",
        "touched",
        "attemptedSubmit",
        "errors",
        "saving",
        "focus"
      ],
      "remountComponents": false
    }
  },
